# Copy to .env.docker and fill in APP_KEY and the two passwords.
# Never commit .env.docker.
APP_NAME=RDVPro
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://rdvpro.test:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rdvpro_central
# Root is for local use only: tenancy has to create one database per tenant.
DB_USERNAME=root
DB_PASSWORD=change-me

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=rdvpro_central

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
